PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/storybook
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
FRONTEND_URL=https://story-book-ai-eta.vercel.app

# Google Gemini — create at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: primary model (falls back to flash-lite / 1.5-flash on quota errors)
# Use a model your key supports — gemini-2.5-flash is recommended (see GET /api/v1/health/ai)
GEMINI_MODEL=gemini-2.5-flash
